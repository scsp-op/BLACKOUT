# Publishing snapshots the workspace file tree, so anything left here from a
# local build is copied into the deployment. These three are rebuilt by the
# build command and are large enough (backend/target reaches several GB) to
# matter.
backend/target/
frontend/node_modules/
frontend/dist/

# Never publish a local database or a stale snapshot artefact. The deployment
# restores its own from App Storage; a copy shipped in the tree would be
# picked up by restore_if_absent's "already present" branch and silently win
# over the real one.
*.db
*.db-shm
*.db-wal
*.db.snapshot
*.db.restore
# A seed snapshot dragged into the workspace to be uploaded to App Storage.
# It belongs in the bucket, not in the publish snapshot — shipping it would
# add ~19 MB to every deploy for a file the app never reads from disk.
*.db.gz
*.sqlite.gz
