# Backend configuration. This file is gitignored — .env.example is the committed template.
# The deployment is public and read-only: there are no auth credentials for
# the app itself. Everything below is either a credential for someone else's
# API, or configuration.

# ── Deployment identity ────────────────────────────────────────────────────
# A short slug naming THIS instance. It goes into the User-Agent of every
# outbound request and into RIPEstat's `sourceapp`, so when two deployments
# run against the same upstreams a provider's logs can tell them apart.
#
# Be clear about what this does NOT do: it does not separate rate limits.
# Those are enforced per-credential (Cloudflare, Pulse, PeeringDB — use a
# separate token per deployment) or per-IP (OONI, IODA, Tor, RIPEstat,
# CelesTrak, SatNOGS — separate hosts already separate these). This is about
# being identifiable, not about getting more quota.
#
# Unset, the app calls itself `local` and says so loudly at boot.
# DEPLOYMENT_ID=scsp-replit

# Where an upstream operator can find out what this is.
# DEPLOYMENT_CONTACT=https://github.com/moumenalaoui/globe

# ── Credentials ────────────────────────────────────────────────────────────
# Optional data-source tokens. If unset, that source is skipped and renders
# empty (a loud WARNING is logged at boot). CLOUDFLARE_API_TOKEN gates two
# features: Radar outage annotations and the HTTP/3 protocol-share signal.
#
# Use a SEPARATE token per deployment. These are the only limits that are
# actually shared between two instances, so one token used twice is the one
# way the two can genuinely throttle each other — and it means neither can be
# revoked without breaking the other.
CLOUDFLARE_API_TOKEN=your_token_here
PULSE_API_TOKEN=your_token_here

# Read by scripts/gen_ixp_data.mjs ONLY — not by the server. PeeringDB
# throttles unauthenticated callers hard (an observed 59-minute lockout after
# three quick requests); a free read-only key from a PeeringDB account's
# profile page raises that substantially. The script works without it, and
# runs so rarely that this is a convenience rather than a requirement.
#   node --env-file=.env scripts/gen_ixp_data.mjs   (from backend/)
PEERINGDB_API_KEY=your_key_here

# Optional overrides. Defaults suit `cargo run` from backend/.
# DATABASE_PATH=mena_ai.db
# SEED_DIR=data/seed
# STATIC_DIR=../frontend/dist
# HEALTH_MAX_AGE_DAYS=2
# FETCH_INTERVAL_HOURS=6
# PORT=3001

# Durable storage (Replit App Storage). Unset here on purpose: with no
# SNAPSHOT_KEY the snapshot layer is completely inert, which is what you want
# locally — the database is just a file you can delete and re-seed.
#
# On Replit this is the ONLY thing keeping the database alive. A published
# app's filesystem is rebuilt from the workspace tree on every publish, and
# three fetchers accumulate history inside bounded rolling windows that
# upstream will never return again (IODA 90d, RIPEstat 14d, Cloudflare 14d),
# on top of the satellite catalog. Set in .replit, not here.
# SNAPSHOT_KEY=mena_ai.db.gz

# How often to write the database back to App Storage. The default is
# deliberately long: a redeploy is covered losslessly by the SIGTERM handler,
# so this only bounds what an unplanned crash costs. Floored at 5 minutes.
# SNAPSHOT_INTERVAL_MINUTES=180

# Shrinkage guard, the same idea as SATELLITE_GROUP_MIN_RETAIN_RATIO below: a
# new snapshot whose uncompressed size is below this fraction of the last good
# one is refused, on the assumption that the local database has been damaged
# rather than genuinely shrunk. Lower it only if the database really did get
# smaller.
# SNAPSHOT_MIN_RETAIN_RATIO=0.5

# Satellite tracking (CelesTrak + SatNOGS, no token needed). Refresh cadence
# matches CelesTrak's own ~2h GP/SupGP update cycle — set lower only for local
# testing, since CelesTrak rate-limits repeat downloads of high-traffic groups.
# The catalog is persistent and additive (see README: Satellite catalog
# persistence), so a restart inside this window performs no fetch at all.
# SATELLITE_CATALOG_REFRESH_HOURS=2

# Age past which an object's orbital data is reported as `stale` by
# /api/satellites and /api/satellites/status. Annotation only — a stale
# satellite is still served; nothing is ever hidden or deleted for being old.
# Measured against `last_updated` (when WE last accepted a better record),
# not the element set's own epoch — see the next setting for why that
# distinction matters.
# SATELLITE_STALE_AFTER_HOURS=24

# Age past which an element set is too old to propagate at all, measured
# against the element-set EPOCH. Objects beyond it stay in the catalog and
# are counted in `total`, but are left out of /api/satellites positions and
# their /api/satellites/:id/orbit returns 422.
#
# This is not a tidiness setting. SatNOGS republishes long-dead objects, so
# the catalog accepts a record now whose orbital data is years old — in one
# observed catalog, 221 objects had an epoch over 30 days old (the oldest
# from February 1975) and every one was reported `fresh`, because
# SATELLITE_STALE_AFTER_HOURS only sees `last_updated`. SGP4 diverges
# outright on the worst of them, and the quieter failure is worse: an object
# a few months stale propagates without error to a position that can be
# thousands of kilometres wrong, drawn on the globe with nothing to mark it
# as fiction.
# SATELLITE_MAX_PROPAGATION_AGE_DAYS=30

# Shrinkage guard. A *successful* group response smaller than this fraction of
# that group's established size is treated as partial: its records are still
# merged (merging can only improve a row), but it does not get to lower the
# baseline used to judge the next response. Guards against a truncated
# response being mistaken for a genuinely smaller catalog. Relative on
# purpose — the real catalog size changes constantly, so no absolute floor
# would stay correct.
# SATELLITE_GROUP_MIN_RETAIN_RATIO=0.5
# `group:category` pairs, comma-separated. Earlier groups win the category tag
# when a NORAD ID appears in more than one. Starlink's SpaceX-derived
# supplemental data is always fetched in addition to this list and overrides a
# general-GP record for the same NORAD ID.
# SATELLITE_GROUPS=starlink:starlink,gps-ops:navigation,galileo:navigation,glo-ops:navigation,beidou:navigation,military:military,resource:earthobs,stations:stations,science:stations,geo:geo,active:other

# Precision/leading-indicator signals — HTTP/3 (QUIC) protocol-share via
# Cloudflare Radar (reuses CLOUDFLARE_API_TOKEN above) and BGP prefix
# visibility via RIPEstat (no token needed). These run on their own faster
# loop, independent of FETCH_INTERVAL_HOURS, since the whole point is to
# catch a protocol collapse or route withdrawal while it's happening.
# PRECISION_FETCH_INTERVAL_HOURS=1
# Overrides the RIPEstat `sourceapp` identifier. Defaults to
# `blackout-<DEPLOYMENT_ID>`, so setting DEPLOYMENT_ID alone is normally
# enough and this stays unset.
# RIPESTAT_SOURCEAPP=blackout-scsp-replit
